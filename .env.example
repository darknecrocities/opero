# ============================================================================
# OPERO — Local-First Workflow Documentation System Configuration (.env.example)
# Copy this file to .env for local development. Never commit .env to Git.
# ============================================================================

# --- Application & Multilingual Defaults (BCP-47) ---
OPERO_ENV=development
OPERO_APP_NAME=OPERO
OPERO_DEFAULT_LOCALE=en-US
OPERO_SUPPORTED_LOCALES=en-US,ja-JP,fil-PH

# --- Local Persistence & SQLCipher Encryption ---
OPERO_DATA_DIR=./data
OPERO_DB_PATH=./data/opero.sqlite3
OPERO_SQLCIPHER_ENABLED=false
OPERO_SQLCIPHER_KEY=
OPERO_RETENTION_DAYS=90

# --- Privacy, Redaction & Capture Guardrails ---
OPERO_OFFLINE_STRICT=true
OPERO_CAPTURE_RAW_KEYSTROKES=false
OPERO_REDACT_PASSWORD_FIELDS=true
OPERO_EXCLUDED_APPS=1Password,Bitwarden,Keychain Access,KeePassXC
OPERO_PERCEPTUAL_HASH_THRESHOLD=0.94

# --- Local AI LLM & Vision-Language Runtime ---
OPERO_LLM_PROVIDER=ollama
OPERO_OLLAMA_HOST=http://127.0.0.1:11434
OPERO_LLAMACPP_BIN_PATH=
OPERO_LLM_INSTRUCTION_MODEL=qwen3:4b-instruct-q4_K_M
OPERO_LLM_FALLBACK_MODEL=gemma3:4b-it-qat
OPERO_VLM_ENABLED=false
OPERO_VLM_MODEL=qwen2.5-vl:3b
OPERO_EMBEDDING_MODEL=bge-small-en-v1.5
OPERO_LLM_CONNECT_TIMEOUT_MS=3000
OPERO_LLM_READ_TIMEOUT_MS=15000

# --- OCR & Accessibility Extraction ---
OPERO_OCR_ENGINE=paddleocr
OPERO_OCR_FALLBACK_ENGINE=tesseract
OPERO_OCR_LANGS=en,japan,latin

# --- Optional Speech Layer (STT / ASR & TTS) ---
# Speech is opt-in and isolated from core capture.
OPERO_SPEECH_ENABLED=false
OPERO_STT_ENGINE=whisper.cpp
OPERO_STT_MODEL_PATH=./models/weights/ggml-base.bin
OPERO_TTS_ENGINE=melotts
# VoiceStudio / LibreTranslate (AGPL-3.0) must run only as isolated optional local services
OPERO_VOICESTUDIO_ISOLATED_API_URL=http://127.0.0.1:8765
OPERO_LIBRETRANSLATE_ISOLATED_API_URL=http://127.0.0.1:5000
OPERO_ALLOW_VOICE_CLONING=false
