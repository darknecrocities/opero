{
  "name": "opero-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "OPERO — MMI Local-First AI Workflow Documentation System",
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "pnpm --filter @opero/desktop dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test:vitest": "vitest run",
    "test:rust": "cargo test --workspace",
    "test:e2e": "pnpm --filter @opero/desktop test:e2e",
    "verify:all": "bash scripts/verify_all_skills.sh"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.8",
    "react": "^19.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
